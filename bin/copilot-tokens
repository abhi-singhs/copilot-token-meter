#!/usr/bin/env node
// copilot-tokens: companion CLI for the copilot-token-meter plugin.
//
//   copilot-tokens status     One-line summary (default).
//   copilot-tokens summary    Multi-line breakdown.
//   copilot-tokens watch      Live tail; refreshes every second.
//   copilot-tokens top        Top sessions by total tokens, all time.
//   copilot-tokens json       Dump the raw status JSON (for scripting).
//   copilot-tokens recompute  Re-aggregate the current session right now.

"use strict";

const fs   = require("fs");
const path = require("path");
const os   = require("os");

const { readJsonl }              = require("../lib/io");
const { aggregate }              = require("../lib/aggregate");
const { loadTelemetryUsage }     = require("../lib/telemetry");
const { formatTokens, formatMs, pad, formatTitle, parseDuration } = require("../lib/format");

const HOME      = process.env.COPILOT_HOME || path.join(os.homedir(), ".copilot");
const STATE_DIR = path.join(HOME, "state", "token-meter");
const SESSIONS  = path.join(HOME, "session-state");

const CLR = {
  reset: "\x1b[0m",  bold: "\x1b[1m",  dim:  "\x1b[2m",
  red:   "\x1b[31m", green:"\x1b[32m", yel:  "\x1b[33m",
  blue:  "\x1b[34m", mag:  "\x1b[35m", cyan: "\x1b[36m",
  white: "\x1b[37m", gray: "\x1b[90m",
};
// Pre-pass argv to extract global flags before subcommand dispatch. Anything
// not recognized as a global flag is passed through to the subcommand.
function parseGlobalFlags(argv) {
  const passthrough = [];
  const flags = { plain: false };
  for (const arg of argv) {
    if (arg === "--plain" || arg === "--no-color") flags.plain = true;
    else passthrough.push(arg);
  }
  return { flags, argv: passthrough };
}

const { flags: GLOBAL_FLAGS, argv: SUBARGV } = parseGlobalFlags(process.argv.slice(2));

// Honour NO_COLOR (https://no-color.org), explicit --plain / --no-color, and
// the lack of a TTY (e.g. when output is piped through tee / less / a script).
const USE_COLOR = !GLOBAL_FLAGS.plain
  && !process.env.NO_COLOR
  && process.stdout.isTTY;
function c(color, s) { return USE_COLOR ? CLR[color] + s + CLR.reset : s; }

// Run the aggregator in-process for `sessionId`. Avoids the ~50ms per-spawn
// cost of fork() — important for `top` and `watch` which call this hot.
function computeStatus(sessionId) {
  if (!sessionId) return null;
  const eventsPath = path.join(SESSIONS, sessionId, "events.jsonl");
  if (!fs.existsSync(eventsPath)) return null;
  const events = readJsonl(eventsPath);
  const telemetry = loadTelemetryUsage(sessionId);
  const agg = aggregate(events, telemetry);
  return {
    schema: 3,
    sessionId,
    eventsPath,
    updatedAt: new Date().toISOString(),
    model:     agg.lastModel,
    totals:    agg.totals,
    perModel:  agg.perModel,
    perTurn:   agg.perTurn.slice(-50),
    perTool:   agg.perTool,
    subAgentTotals: agg.subAgentTotals,
    quota:     agg.quota,
    telemetryAvailable: agg.telemetryAvailable,
    telemetryRecords:   agg.telemetryRecords,
    title:     formatTitle(agg),
  };
}

function loadStatus() {
  const latest = path.join(STATE_DIR, "latest.json");
  if (fs.existsSync(latest)) {
    try {
      const s = JSON.parse(fs.readFileSync(latest, "utf8"));
      // Schema 1/2 was on-disk-only; recompute to pick up new fields.
      if (s && s.schema === 3) return s;
    } catch (_) {}
  }
  return recomputeLatest();
}

function recomputeLatest() {
  const sessionId = mostRecentSessionId();
  return computeStatus(sessionId);
}

function mostRecentSessionId() {
  if (!fs.existsSync(SESSIONS)) return null;
  let best = null, bestMtime = 0;
  for (const id of fs.readdirSync(SESSIONS)) {
    const ev = path.join(SESSIONS, id, "events.jsonl");
    try {
      const s = fs.statSync(ev);
      if (s.mtimeMs > bestMtime) { bestMtime = s.mtimeMs; best = id; }
    } catch (_) {}
  }
  return best;
}

function contextBar(pct) {
  if (pct == null) return "";
  const width = 10;
  const filled = Math.min(width, Math.max(0, Math.round(pct * width)));
  const bar = USE_COLOR
    ? "▮".repeat(filled) + "▯".repeat(width - filled)
    : "[" + "#".repeat(filled) + " ".repeat(width - filled) + "]";
  const pctStr = (pct * 100).toFixed(1) + "%";
  if (pct > 0.95)   return c("red",   bar + " " + pctStr);
  if (pct > 0.80)   return c("yel",   bar + " " + pctStr);
  return c("green", bar + " " + pctStr);
}

function renderStatusLine(st) {
  if (!st) return c("gray", "no active copilot session");
  const t = st.totals;
  const model = (st.model || "?").replace(/^claude-/, "");
  const parts = [
    c("bold", "copilot"),
    c("gray", "[" + model + "]"),
    c("cyan",  "↑" + formatTokens(t.inputTokens) + "in"),
    c("green", "↓" + formatTokens(t.outputTokens) + "out"),
    c("blue",  "⟳" + formatTokens(t.cacheReadTokens) + "cr"),
    c("mag",   "⊕" + formatTokens(t.cacheWriteTokens) + "cw"),
  ];
  if (t.contextUtilization != null) {
    parts.push(c("yel", "📦" + (t.contextUtilization * 100).toFixed(0) + "%"));
  }
  parts.push(c("gray", t.turns + "t/" + t.toolCalls + "🔧"));
  return parts.join(" ");
}

function renderSummary(st) {
  if (!st) {
    console.log(c("gray", "No copilot session found. Start `copilot` first."));
    return;
  }
  const t = st.totals;
  const lines = [];
  lines.push(c("bold", "Copilot session ") + c("gray", st.sessionId));
  lines.push(c("gray", "Updated " + new Date(st.updatedAt).toLocaleString() + "  •  model: ") + (st.model || "?"));
  if (st.telemetryAvailable) {
    lines.push(c("gray", "Source: telemetry log (" + (st.telemetryRecords||0) + " API calls observed)"));
  } else {
    lines.push(c("yel",  "Source: events.jsonl only (input / cache unavailable in this CLI build)"));
  }
  lines.push("");

  lines.push(c("bold", "Tokens"));
  lines.push("  " + pad("input",         18) + c("cyan",  formatTokens(t.inputTokens).padStart(10))      + "  " + c("gray", t.inputTokens.toLocaleString()));
  lines.push("  " + pad("output",        18) + c("green", formatTokens(t.outputTokens).padStart(10))     + "  " + c("gray", t.outputTokens.toLocaleString()));
  lines.push("  " + pad("cache read",    18) + c("blue",  formatTokens(t.cacheReadTokens).padStart(10))  + "  " + c("gray", t.cacheReadTokens.toLocaleString()));
  lines.push("  " + pad("cache write",   18) + c("mag",   formatTokens(t.cacheWriteTokens).padStart(10)) + "  " + c("gray", t.cacheWriteTokens.toLocaleString()));
  if ((t.reasoningTokens || 0) > 0) {
    lines.push("  " + pad("reasoning",   18) + c("mag",   formatTokens(t.reasoningTokens).padStart(10))  + "  " + c("gray", t.reasoningTokens.toLocaleString()));
  }
  lines.push("  " + pad("prompt (wire)", 18) + c("yel",   formatTokens(t.promptTokens || 0).padStart(10))+ "  " + c("gray", (t.promptTokens || 0).toLocaleString()));
  lines.push("  " + pad("total billed*", 18) + c("yel",   formatTokens(t.billedTokens || 0).padStart(10))+ "  " + c("gray", (t.billedTokens || 0).toLocaleString()));
  lines.push("");

  if (t.contextUtilization != null) {
    lines.push(c("bold", "Context window"));
    lines.push("  " + pad("utilization", 18) + contextBar(t.contextUtilization)
      + c("gray", "  (" + (t.lastCallPromptTokens || 0).toLocaleString() + " / " + (t.contextWindow || 0).toLocaleString() + ", most recent call)"));
    lines.push("");
  }

  lines.push(c("bold", "Activity"));
  lines.push("  " + pad("turns",         18) + String(t.turns).padStart(10));
  lines.push("  " + pad("tool calls",    18) + String(t.toolCalls).padStart(10));
  lines.push("  " + pad("user messages", 18) + String(t.userMessages).padStart(10));
  lines.push("  " + pad("API calls",     18) + String(t.apiCalls).padStart(10));
  if (t.durationMs > 0)   lines.push("  " + pad("API time",   18) + formatMs(t.durationMs).padStart(10));
  lines.push("");

  // Burn rate over the last 5 / 30 min — computed from history.jsonl.
  const burn = computeBurnRate(st.sessionId);
  if (burn && (burn.last5min.tokens > 0 || burn.last30min.tokens > 0)) {
    lines.push(c("bold", "Burn rate"));
    lines.push("  " + pad("last 5 min",  18) + c("cyan",  formatTokens(burn.last5min.tokens).padStart(10))  + c("gray", "  " + formatTokens(burn.last5min.tokensPerMin) + "/min"));
    lines.push("  " + pad("last 30 min", 18) + c("cyan",  formatTokens(burn.last30min.tokens).padStart(10)) + c("gray", "  " + formatTokens(burn.last30min.tokensPerMin) + "/min"));
    if (t.contextUtilization != null && t.contextUtilization < 1 && burn.last5min.tokensPerMin > 0) {
      const remaining = (t.contextWindow || 0) - (t.promptTokens || 0);
      const etaMin = remaining / burn.last5min.tokensPerMin;
      if (etaMin > 0 && etaMin < 24 * 60) {
        lines.push("  " + pad("ETA to ctx full", 18) + c("yel", formatMs(etaMin * 60_000).padStart(10)));
      }
    }
    lines.push("");
  }

  const models = Object.entries(st.perModel || {});
  if (models.length > 1) {
    lines.push(c("bold", "By model"));
    for (const [m, b] of models) {
      lines.push("  " + pad(m, 30)
        + c("cyan",  "↑" + formatTokens(b.inputTokens).padStart(8))
        + c("green", " ↓" + formatTokens(b.outputTokens).padStart(8))
        + c("blue",  " ⟳" + formatTokens(b.cacheReadTokens).padStart(8))
        + c("mag",   " ⊕" + formatTokens(b.cacheWriteTokens).padStart(8))
        + c("gray",  " " + b.apiCalls + " calls"));
    }
    lines.push("");
  }

  const tools = Object.values(st.perTool || {})
    .filter(t => t.calls > 0)
    .sort((a, b) => (b.inputTokens + b.outputTokens + b.cacheReadTokens) - (a.inputTokens + a.outputTokens + a.cacheReadTokens));
  if (tools.length > 0) {
    lines.push(c("bold", "By tool"));
    for (const tool of tools.slice(0, 12)) {
      lines.push("  " + pad(tool.name, 22)
        + c("gray",  pad(String(tool.calls), 4) + "calls")
        + c("cyan",  " ↑" + formatTokens(tool.inputTokens).padStart(7))
        + c("green", " ↓" + formatTokens(tool.outputTokens).padStart(7))
        + c("blue",  " ⟳" + formatTokens(tool.cacheReadTokens).padStart(7))
        + c("mag",   " ⊕" + formatTokens(tool.cacheWriteTokens).padStart(7)));
    }
    lines.push("");
  }

  // Sub-agents: spend delegated to task/explore/etc. Always render if any
  // sub-agent activity is present; otherwise stay silent.
  const sub = st.subAgentTotals;
  if (sub && sub.apiCalls > 0) {
    lines.push(c("bold", "Sub-agents") + c("gray", "  (delegated work)"));
    lines.push("  " + pad("API calls",     18) + String(sub.apiCalls).padStart(10));
    lines.push("  " + pad("input",         18) + c("cyan",  formatTokens(sub.inputTokens).padStart(10)));
    lines.push("  " + pad("output",        18) + c("green", formatTokens(sub.outputTokens).padStart(10)));
    lines.push("  " + pad("cache read",    18) + c("blue",  formatTokens(sub.cacheReadTokens).padStart(10)));
    lines.push("  " + pad("cache write",   18) + c("mag",   formatTokens(sub.cacheWriteTokens).padStart(10)));
    const subModels = Object.keys(sub.perModel || {});
    if (subModels.length > 0) {
      lines.push("  " + pad("models", 18) + subModels.join(", "));
    }
    lines.push("");
  }

  if (st.perTurn && st.perTurn.length) {
    lines.push(c("bold", "Last turns"));
    for (const turn of st.perTurn.slice(-8)) {
      lines.push("  turn " + pad("#" + turn.turnId, 6)
        + c("cyan",  "↑" + formatTokens(turn.inputTokens).padStart(7))
        + c("green", " ↓" + formatTokens(turn.outputTokens).padStart(7))
        + c("blue",  " ⟳" + formatTokens(turn.cacheReadTokens).padStart(7))
        + c("mag",   " ⊕" + formatTokens(turn.cacheWriteTokens).padStart(7))
        + c("gray",  " " + turn.toolCalls + "🔧 " + formatMs(turn.durationMs).padStart(7))
        + "  " + c("gray", (turn.model || "?").replace(/^claude-/, "")));
    }
    lines.push("");
  }

  if (st.quota && st.quota.metrics) {
    const q = st.quota.metrics;
    lines.push(c("bold", "Quota") + c("gray", "  (" + (st.quota.properties && st.quota.properties.copilot_plan || "?") + " plan)"));
    if (typeof q.premium_interactions_remaining === "number") {
      lines.push("  " + pad("premium interactions", 22) + (q.premium_interactions_remaining + " / " + (q.premium_interactions_entitlement || "?")));
    }
    if (typeof q.chat_remaining === "number") {
      lines.push("  " + pad("chat", 22) + (q.chat_remaining + " / " + (q.chat_entitlement || "?")));
    }
    if (typeof q.completions_remaining === "number") {
      lines.push("  " + pad("completions", 22) + (q.completions_remaining + " / " + (q.completions_entitlement || "?")));
    }
    lines.push("");
  }

  lines.push(c("gray", "* Billed tokens = input + output + cache_write + cache_read/10 (Anthropic-style)."));
  console.log(lines.join("\n"));
}

// Compute tokens-per-minute and last-N-minutes deltas from history.jsonl.
function computeBurnRate(sessionId) {
  if (!sessionId) return null;
  const hist = path.join(STATE_DIR, "history-" + sessionId + ".jsonl");
  if (!fs.existsSync(hist)) return null;
  let lines;
  try { lines = fs.readFileSync(hist, "utf8").trim().split("\n"); } catch (_) { return null; }
  const snapshots = [];
  for (const line of lines) {
    try { snapshots.push(JSON.parse(line)); } catch (_) {}
  }
  if (snapshots.length === 0) return null;
  const now = Date.now();
  function windowDelta(min) {
    const cutoff = now - min * 60_000;
    let start = null;
    for (const s of snapshots) {
      if (s.ts >= cutoff) { start = s; break; }
    }
    const end = snapshots[snapshots.length - 1];
    if (!start || !end || start === end) {
      return { tokens: 0, tokensPerMin: 0, durationMs: 0 };
    }
    const tokens = (end.promptTokens - start.promptTokens) + (end.outputTokens - start.outputTokens);
    const dur = end.ts - start.ts;
    return {
      tokens,
      tokensPerMin: dur > 0 ? Math.round(tokens / (dur / 60_000)) : 0,
      durationMs: dur,
    };
  }
  return { last5min: windowDelta(5), last30min: windowDelta(30) };
}

// Tiny ASCII sparkline of tokens/min over the last N data points.
function renderSparkline(values, width) {
  if (!values || values.length === 0) return "";
  const chars = "▁▂▃▄▅▆▇█";
  const max = Math.max(...values, 1);
  return values.slice(-width).map(v => {
    const idx = Math.min(chars.length - 1, Math.floor((v / max) * (chars.length - 1)));
    return chars[idx];
  }).join("");
}

function cmdStatus() { console.log(renderStatusLine(loadStatus())); }
function cmdSummary() { renderSummary(loadStatus()); }
function cmdJson()    { const s = loadStatus(); console.log(JSON.stringify(s, null, 2)); }
function cmdRecompute() { console.log(renderStatusLine(recomputeLatest())); }

function cmdWatch() {
  const intervalMs = 1000;
  const isTTY = process.stdout.isTTY;
  let prevId = null;
  function tick() {
    const st = recomputeLatest();
    if (isTTY) process.stdout.write("\x1b[2J\x1b[H");
    if (!st) { console.log(c("gray", "Waiting for a copilot session…")); return; }
    if (st.sessionId !== prevId) {
      prevId = st.sessionId;
      if (isTTY) process.stdout.write("\x1b]2;" + st.title + "\x07");
    }
    renderSummary(st);

    // Sparkline of recent tokens/min.
    const hist = path.join(STATE_DIR, "history-" + st.sessionId + ".jsonl");
    if (fs.existsSync(hist)) {
      try {
        const snaps = fs.readFileSync(hist, "utf8").trim().split("\n").slice(-40).map(JSON.parse);
        const rates = [];
        for (let i = 1; i < snaps.length; i++) {
          const dt = snaps[i].ts - snaps[i-1].ts;
          if (dt <= 0) continue;
          const dTok = (snaps[i].promptTokens - snaps[i-1].promptTokens) + (snaps[i].outputTokens - snaps[i-1].outputTokens);
          rates.push(dTok / (dt / 60_000));
        }
        if (rates.length > 0) {
          console.log(c("gray", "tokens/min ") + renderSparkline(rates, 40));
        }
      } catch (_) {}
    }
    console.log(c("gray", "watching… (Ctrl-C to exit)"));
  }
  tick();
  const h = setInterval(tick, intervalMs);
  process.on("SIGINT", () => { clearInterval(h); process.exit(0); });
}

// Tiny argv parser for subcommand flags. Supports `--name value` and
// `--name=value`. Returns { flags: { name: rawValue }, rest: [positional] }.
// Callers coerce types and validate values themselves.
function parseSubFlags(argv) {
  const flags = Object.create(null);
  const rest = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith("--")) {
      const eq = a.indexOf("=");
      if (eq !== -1) {
        flags[a.slice(2, eq)] = a.slice(eq + 1);
      } else {
        const name = a.slice(2);
        const next = argv[i + 1];
        if (next != null && !next.startsWith("--")) {
          flags[name] = next;
          i++;
        } else {
          flags[name] = true;
        }
      }
    } else {
      rest.push(a);
    }
  }
  return { flags, rest };
}

function cmdTop(rawArgv) {
  const { flags } = parseSubFlags(rawArgv || []);

  let limit = 20;
  if (flags.limit != null) {
    const parsed = parseInt(flags.limit, 10);
    if (!isFinite(parsed) || parsed <= 0) {
      console.error("Invalid --limit value: " + flags.limit);
      process.exit(2);
    }
    limit = parsed;
  }

  let cutoffMs = 0;
  if (flags.since != null) {
    const dur = parseDuration(flags.since);
    if (dur == null) {
      console.error("Invalid --since value: " + flags.since +
        " (expected e.g. 30m, 24h, 7d, 2w)");
      process.exit(2);
    }
    cutoffMs = Date.now() - dur;
  }

  if (!fs.existsSync(SESSIONS)) { console.log(c("gray", "No sessions yet.")); return; }
  const rows = [];
  for (const id of fs.readdirSync(SESSIONS)) {
    const ev = path.join(SESSIONS, id, "events.jsonl");
    if (!fs.existsSync(ev)) continue;
    const stat = fs.statSync(ev);
    if (cutoffMs > 0 && stat.mtimeMs < cutoffMs) continue;
    const st = computeStatus(id);
    if (!st) continue;
    const t = st.totals;
    if ((t.inputTokens + t.outputTokens) === 0) continue;
    rows.push({
      id, model: st.model, in: t.inputTokens, out: t.outputTokens,
      cr: t.cacheReadTokens, cw: t.cacheWriteTokens,
      turns: t.turns, tools: t.toolCalls,
      mtime: stat.mtimeMs,
    });
  }
  rows.sort((a, b) => (b.in + b.out + b.cr + b.cw) - (a.in + a.out + a.cr + a.cw));
  if (flags.since != null) {
    console.log(c("gray", "Showing " + Math.min(limit, rows.length) + " of " +
      rows.length + " sessions (last " + flags.since + ")"));
  }
  console.log(c("bold",
    pad("session", 38) + pad("model", 22) +
    pad("↑in", 10) + pad("↓out", 10) +
    pad("⟳read", 10) + pad("⊕write", 10) +
    pad("turns", 7) + pad("tools", 7)));
  for (const r of rows.slice(0, limit)) {
    console.log(
      pad(r.id, 38) + pad((r.model || "?").replace(/^claude-/, ""), 22) +
      pad(c("cyan",  formatTokens(r.in)),  10) +
      pad(c("green", formatTokens(r.out)), 10) +
      pad(c("blue",  formatTokens(r.cr)),  10) +
      pad(c("mag",   formatTokens(r.cw)),  10) +
      pad(String(r.turns), 7) + pad(String(r.tools), 7));
  }
}

function cmdHelp() {
  console.log([
    c("bold", "copilot-tokens") + " — live token meter for GitHub Copilot CLI",
    "",
    "Usage:",
    "  copilot-tokens [status]     One-line summary of the current session",
    "  copilot-tokens summary      Multi-line breakdown (per model, per tool, per turn)",
    "  copilot-tokens watch        Live updating dashboard (refreshes every 1s)",
    "  copilot-tokens top          Top sessions by total tokens across all history",
    "                              [--limit N] [--since 7d|24h|30m]",
    "  copilot-tokens json         Emit the raw status JSON",
    "  copilot-tokens recompute    Re-scan the current session and refresh state",
    "  copilot-tokens help         Show this help",
    "",
    "Global flags:",
    "  --plain, --no-color         Disable ANSI colour (also honoured: NO_COLOR=1)",
    "",
    "State files:",
    "  " + path.join(STATE_DIR, "latest.json"),
    "  " + path.join(STATE_DIR, "<sessionId>.json"),
    "  " + path.join(STATE_DIR, "history-<sessionId>.jsonl"),
    "  " + path.join(STATE_DIR, "current"),
  ].join("\n"));
}

const cmd = (SUBARGV[0] || "status").toLowerCase();
switch (cmd) {
  case "status":    cmdStatus(); break;
  case "summary":   cmdSummary(); break;
  case "watch":     cmdWatch(); break;
  case "top":       cmdTop(SUBARGV.slice(1)); break;
  case "json":      cmdJson(); break;
  case "recompute": cmdRecompute(); break;
  case "help":
  case "--help":
  case "-h":        cmdHelp(); break;
  default:
    console.error("Unknown command: " + cmd);
    cmdHelp();
    process.exit(2);
}
